{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "plugins": ["@trivago/prettier-plugin-sort-imports"],
    "importOrder": [
        "^react$",
        "^react-router$",
        "<THIRD_PARTY_MODULES>",
        "^\\.\\./\\.\\./app/(.*)$",
        "^\\.\\./\\.\\./pages/(.*)$",
        "^\\.\\./\\.\\./widgets/(.*)$",
        "^\\.\\./\\.\\./features/(.*)$",
        "^\\.\\./\\.\\./entities/(.*)$",
        "^\\.\\./\\.\\./shared/(.*)$",
        "^[./]",
        "\\.css$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}
